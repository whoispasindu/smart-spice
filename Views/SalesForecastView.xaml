<UserControl x:Class="SmartSpice.Views.SalesForecastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,16">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="8,4,8,8">
                <TextBlock Text="AI Sales Prediction" Style="{StaticResource H1}"/>
                <TextBlock Text="Forecasts trained on 3 years of company sales history (trend + seasonality)."
                           Style="{StaticResource Caption}" FontSize="13"/>
            </StackPanel>

            <!-- High-season warning -->
            <Border Style="{StaticResource Card}" Background="#FFF3E0" BorderThickness="0"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource WarningBrush}">
                        <TextBlock Text="⚠" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Stock-up alert" FontWeight="Bold" FontSize="14" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="{Binding WarningText}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="900"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Product forecast -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🤖" FontSize="16"/>
                                <TextBlock Text="Next 3-Month Forecast" Style="{StaticResource H2}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                      Width="200" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 3 month cards -->
                        <ItemsControl ItemsSource="{Binding Forecast}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="14" Margin="5" BorderThickness="1"
                                            BorderBrush="{StaticResource BorderBrush}" Background="White">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"/>
                                                <Border CornerRadius="7" Padding="7,2" Background="{StaticResource AccentPaleBrush}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Visibility="{Binding IsHighSeason, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="HIGH" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Units, StringFormat={}{0:N0}}" FontSize="26" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                                            <TextBlock Text="units predicted" Style="{StaticResource Caption}" FontSize="11"/>
                                            <Border Background="#EAEFE6" CornerRadius="4" Height="6" Margin="0,8,0,0">
                                                <Border Background="{StaticResource GreenBarBrush}" CornerRadius="4" HorizontalAlignment="Left"
                                                        Width="{Binding Fraction, Converter={StaticResource FractionToWidth}, ConverterParameter=120}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Revenue, StringFormat={}LKR {0:N0}}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding Kg, StringFormat={}{0:N0} kg}" Style="{StaticResource Caption}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="5,12"/>
                        <Grid Margin="5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="3-Month Total" Style="{StaticResource Caption}" FontSize="11"/>
                                <TextBlock Text="{Binding HorizonTotal}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Trend" Style="{StaticResource Caption}" FontSize="11"/>
                                <TextBlock Text="{Binding TrendText}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Model Confidence" Style="{StaticResource Caption}" FontSize="11"/>
                                <TextBlock Text="{Binding Confidence, StringFormat={}{0}%}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Top products -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Top Sellers (next 3 months)" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                        <TextBlock Text="Which products are predicted to sell the most." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding TopProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding Product}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Units, StringFormat={}{0:N0} units}" HorizontalAlignment="Right"
                                                       FontSize="12.5" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Border Grid.Row="1" Background="#EAEFE6" CornerRadius="4" Height="9" Margin="0,5,0,0">
                                            <Border Background="{StaticResource AccentGradientBrush}" CornerRadius="4" HorizontalAlignment="Left"
                                                    Width="{Binding Fraction, Converter={StaticResource FractionToWidth}, ConverterParameter=230}"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Revenue, StringFormat={}LKR {0:N0}}"
                                                   Style="{StaticResource Caption}" FontSize="10.5" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Background="{StaticResource PrimaryPaleBrush}" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="How this works" FontWeight="SemiBold" FontSize="12.5"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="The model is trained on 36 months of real sales. For each product it fits a long-term growth trend and learns a seasonal pattern (which calendar months sell more). It then projects the next three months and raises a stock-up alert when an upcoming month is a known high-demand period."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
