<UserControl x:Class="SmartSpice.Views.BatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel Margin="20,4,20,16">
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="8,4,8,8">
                <StackPanel>
                    <TextBlock Text="Harvest &amp; Processing" Style="{StaticResource H1}"/>
                    <TextBlock Text="Track and manage all harvest and processing activities." Style="{StaticResource Caption}" FontSize="13"/>
                </StackPanel>
                <Button Content="+ New Batch" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Command="{Binding StartCreateCommand}"/>
            </Grid>

            <!-- Stat cards -->
            <UniformGrid DockPanel.Dock="Top" Columns="4">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#E3F1DF">
                            <TextBlock Text="🧺" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Total Batches" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding TotalBatches}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#FBEFD2">
                            <TextBlock Text="⚙" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="In Pipeline" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding ActiveBatches}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#DDEAF6">
                            <TextBlock Text="🌾" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Total Raw" Style="{StaticResource Caption}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RawTotal}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="KG" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,3" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#E3F1DF">
                            <TextBlock Text="📈" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Avg Yield" Style="{StaticResource Caption}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AvgYield}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="%" FontSize="12" VerticalAlignment="Bottom" Margin="2,0,0,3" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Table -->
            <Border Style="{StaticResource Card}" Padding="6">
                <DataGrid ItemsSource="{Binding Batches}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Batch ID" Binding="{Binding BatchCode}" Width="150"/>
                        <DataGridTextColumn Header="Spice Type" Binding="{Binding SpiceType}" Width="*"/>
                        <DataGridTextColumn Header="Farmer / Section" Binding="{Binding Farmer.FarmName}" Width="*"/>
                        <DataGridTextColumn Header="Raw (KG)" Binding="{Binding RawWeightKg, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="Yield %" Binding="{Binding YieldPercent, StringFormat=N1, TargetNullValue=—}" Width="90"/>
                        <DataGridTemplateColumn Header="Status" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPill}"
                                            Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
                                        <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Action" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowAction}" Content="⋯"
                                            Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ===== Create overlay ===== -->
        <Grid Background="#66000000" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="New Batch (Farm Collection)" Style="{StaticResource H2}"/>
                    <TextBlock Text="FARMER" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Farmers}" DisplayMemberPath="FarmName" SelectedItem="{Binding NewFarmer}"/>
                    <TextBlock Text="PRODUCT (select from list)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding RawProducts}" SelectedItem="{Binding NewSpiceType}"/>
                    <TextBlock Text="STORE IN WAREHOUSE" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedItem="{Binding NewWarehouse}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="RAW WEIGHT (KG)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewRawWeight, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="MOISTURE (%)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewMoisture, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="DRYING DURATION (HOURS)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding NewDryingHours, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid Margin="0,18,0,0">
                        <Button Content="Cancel" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding CancelCreateCommand}"/>
                        <Button Content="Create Batch" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding CreateBatchCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Detail overlay ===== -->
        <Grid Background="#66000000" Visibility="{Binding IsDetail, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="480" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.BatchCode}" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Caption}">
                                    <Run Text="{Binding Selected.SpiceType, Mode=OneWay}"/><Run Text=" • status "/>
                                    <Run Text="{Binding Selected.Status, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource RowAction}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding CloseDetailCommand}"/>
                        </Grid>

                        <UniformGrid Columns="2">
                            <Border Background="{StaticResource PrimaryPaleBrush}" CornerRadius="10" Padding="12" Margin="0,0,4,4">
                                <StackPanel>
                                    <TextBlock Text="Raw" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Selected.RawWeightKg, StringFormat={}{0:N0} kg}" FontWeight="Bold" FontSize="16"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource AccentPaleBrush}" CornerRadius="10" Padding="12" Margin="4,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="Processed" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Selected.ProcessedWeightKg, StringFormat={}{0:N0} kg, TargetNullValue=—}" FontWeight="Bold" FontSize="16"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Background="{StaticResource PrimaryPaleBrush}" CornerRadius="10" Padding="12" Margin="0,4,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Moisture" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Selected.MoisturePercent, StringFormat={}{0:N1}%}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="Drying" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Selected.DryingHours, StringFormat={}{0:N0} hrs}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="#FFF3E0" CornerRadius="10" Padding="12" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Grinding Yield Loss" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding Selected.YieldLossPercent, StringFormat={}{0:N2}% lost to dust &amp; moisture, TargetNullValue=Not yet ground}"
                                           FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Advance to Next Stage ▶" Style="{StaticResource AccentButton}" Margin="0,14,0,0"
                                Command="{Binding AdvanceStageCommand}"/>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16"/>
                        <TextBlock Text="RECORD GRINDING OUTPUT (KG)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ProcessedWeight, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding RecordGrindingCommand}"/>
                        </Grid>

                        <TextBlock Text="Processing History" Style="{StaticResource FieldLabel}" Margin="2,16,0,4"/>
                        <ItemsControl ItemsSource="{Binding Records}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F6FAF3" CornerRadius="8" Padding="10,7" Margin="0,3">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" FontSize="12">
                                                <Run Text="{Binding Stage, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding Method, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding WeightBeforeKg, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text=" → "/>
                                                <Run Text="{Binding WeightAfterKg, StringFormat={}{0:N0} kg, Mode=OneWay}"/>
                                                <Run Text="  (loss "/><Run Text="{Binding LossPercent, StringFormat={}{0:N1}%, Mode=OneWay}"/><Run Text=")"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
