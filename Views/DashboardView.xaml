<UserControl x:Class="SmartSpice.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,20">
        <StackPanel>
            
            <Grid Margin="8,4,8,6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Welcome back, " Style="{StaticResource H1}"/>
                        <TextBlock Text="{Binding UserName}" Style="{StaticResource H1}"/>
                        <TextBlock Text="! 🌱" Style="{StaticResource H1}"/>
                    </StackPanel>
                    <TextBlock Text="Here's what's happening in your plantation today."
                               Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="White" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📅" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding TodayLong}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding TodayDay}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            
            <ItemsControl ItemsSource="{Binding Kpis}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="6">
                            <StackPanel>
                                <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left"
                                        Background="{Binding IconBackground}">
                                    <TextBlock Text="{Binding Icon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Margin="0,12,0,2" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Value}" FontSize="21" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Unit}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                    <TextBlock Text="{Binding Trend}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Bottom" Margin="6,0,0,3"
                                               Visibility="{Binding ShowTrend, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Sub}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- AI Sales Forecast (next month) -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🤖" FontSize="16"/>
                                <TextBlock Text="AI Sales Forecast" Style="{StaticResource H2}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Button Content="View All" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="forecast"/>
                        </Grid>

                        <TextBlock Text="Predicted Sales — Next Month" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SalesMonthLabel}" Style="{StaticResource Caption}"/>

                       
                        <Border Background="{StaticResource PrimaryPaleBrush}" CornerRadius="12" Padding="16,13" Margin="0,12,0,0">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Forecast Revenue" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding SalesRevenue}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding SalesUnits, StringFormat={}{0} units predicted}" Style="{StaticResource Caption}" FontSize="11"/>
                                </StackPanel>
                                <Border Width="58" Height="58" CornerRadius="14" Background="{StaticResource PrimaryBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Top Seller Next Month" Style="{StaticResource Caption}" FontSize="11"/>
                                <TextBlock Text="{Binding SalesTopProduct}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="vs 12-Month Average" Style="{StaticResource Caption}" FontSize="11"/>
                                <TextBlock Text="{Binding SalesVsAvg}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Grid>

                       
                        <Border Background="#FFF3E0" CornerRadius="10" Padding="12,9" Margin="0,14,0,0"
                                Visibility="{Binding SalesHighSeason, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="⚠ Stock-up alert" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock Text="{Binding SalesWarning}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Harvest Overview" Style="{StaticResource H2}"/>
                            <Border HorizontalAlignment="Right" Background="White" CornerRadius="8"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,5">
                                <TextBlock Text="This Month  ▾" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="200" Height="200">
                                <ItemsControl ItemsSource="{Binding Donut}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding Geometry}" Fill="{Binding Brush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DonutTotal}" FontSize="24" FontWeight="Bold"
                                               HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="KG" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Donut}" VerticalAlignment="Center" Margin="18,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="54"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="11" Height="11" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="9,0,10,0" VerticalAlignment="Center" FontSize="13"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Kg}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Percent}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                
                <Border Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource SpiceGradientBrush}" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="Plantation Health Score" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        <Grid Width="200" Height="200" Margin="0,10,0,0">
                            <Path Data="{Binding GaugeTrack}" Stroke="#33FFFFFF" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="{Binding GaugeValue}" Stroke="#8BC34A" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HealthScore}" FontSize="46" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="/100" Foreground="#A9C8A0" HorizontalAlignment="Center" Margin="0,-6,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding HealthLabel}" Foreground="{StaticResource LeafBrush}" FontWeight="Bold"
                                   FontSize="16" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="Keep up the great work!" Foreground="#A9C8A0" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

               
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Recent Activities" Style="{StaticResource H2}"/>
                            <Button Content="View All" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="audit"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Activities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource PrimaryPaleBrush}">
                                            <TextBlock Text="{Binding Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Time}" VerticalAlignment="Center"
                                                   Style="{StaticResource Caption}" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

               
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Top Spice Stock" Style="{StaticResource H2}"/>
                            <Button Content="View All" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="inventory"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TopStock}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Border Background="#EAEFE6" CornerRadius="4" Height="7"/>
                                                <Border Background="{Binding Brush}" CornerRadius="4" Height="7" HorizontalAlignment="Left"
                                                        Width="{Binding Fraction, Converter={StaticResource FractionToWidth}, ConverterParameter=150}"/>
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" FontSize="12.5" Margin="10,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Warehouse &amp; Bin Capacity" Style="{StaticResource H2}"/>
                        <Button Content="View All" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="warehouses"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding WarehouseBars}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="13"/>
                                    <Border Grid.Column="1" Background="#EAEFE6" CornerRadius="7" Height="16" ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource PercentToStar}}"/>
                                                <ColumnDefinition Width="{Binding EmptyFraction, Converter={StaticResource PercentToStar}}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{Binding Brush}" CornerRadius="7"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{Binding Brush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            
            <Border Style="{StaticResource Card}" Background="{StaticResource CreamBrush}" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="📈" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Revenue Forecast" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Expected revenue for June 2026 is" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RevenueForecast}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding RevenueForecastTrend}" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Content="View Detailed Report  →" Style="{StaticResource DarkButton}"
                            VerticalAlignment="Center" Margin="10,0,0,0"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="audit"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl> 
