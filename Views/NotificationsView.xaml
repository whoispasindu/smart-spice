<<UserControl x:Class="SmartSpice.Views.NotificationsView"
			xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="22">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Notifications &amp; Alerts" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="Mark all read" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding MarkAllReadCommand}"/>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Notifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="14,11" Margin="0,4" BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrush}" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,12,0"
                                            Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" FontSize="11" HorizontalAlignment="Right"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat=g}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
    </UserControl>  