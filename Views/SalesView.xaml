<UserControl x:Class="SmartSpice.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid>
		<DockPanel Margin="20,4,20,16">
			<!-- Header -->
			<Grid DockPanel.Dock="Top" Margin="8,4,8,8">
				<StackPanel>
					<TextBlock Text="Dispatch Products" Style="{StaticResource H1}"/>
					<TextBlock Text="Manage export orders and shipments." Style="{StaticResource Caption}" FontSize="13"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
					<Button Content="+ New Buyer" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                            Command="{Binding StartAddBuyerCommand}"/>
					<Button Content="+ New Export Order" Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartCreateCommand}"/>
				</StackPanel>
			</Grid>

			<!-- Stat cards -->
			<UniformGrid DockPanel.Dock="Top" Columns="4">
				<Border Style="{StaticResource StatCard}">
					<StackPanel Orientation="Horizontal">
						<Border Width="44" Height="44" CornerRadius="12" Background="#E3F1DF">
							<TextBlock Text="🧾" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
							<TextBlock Text="Total Orders" Style="{StaticResource Caption}"/>
							<TextBlock Text="{Binding TotalOrders}" FontSize="20" FontWeight="Bold"/>
						</StackPanel>
					</StackPanel>
				</Border>
				<Border Style="{StaticResource StatCard}">
					<StackPanel Orientation="Horizontal">
						<Border Width="44" Height="44" CornerRadius="12" Background="#DDEAF6">
							<TextBlock Text="🚚" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
							<TextBlock Text="In Transit" Style="{StaticResource Caption}"/>
							<TextBlock Text="{Binding InTransit}" FontSize="20" FontWeight="Bold"/>
						</StackPanel>
					</StackPanel>
				</Border>
				<Border Style="{StaticResource StatCard}">
					<StackPanel Orientation="Horizontal">
						<Border Width="44" Height="44" CornerRadius="12" Background="#E3F1DF">
							<TextBlock Text="✅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
							<TextBlock Text="Delivered" Style="{StaticResource Caption}"/>
							<TextBlock Text="{Binding Delivered}" FontSize="20" FontWeight="Bold"/>
						</StackPanel>
					</StackPanel>
				</Border>
				<Border Style="{StaticResource StatCard}">
					<StackPanel Orientation="Horizontal">
						<Border Width="44" Height="44" CornerRadius="12" Background="#FBEFD2">
							<TextBlock Text="💰" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
							<TextBlock Text="Total Revenue" Style="{StaticResource Caption}"/>
							<TextBlock Text="{Binding Revenue}" FontSize="20" FontWeight="Bold"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</UniformGrid>

			<!-- Table -->
			<Border Style="{StaticResource Card}" Padding="6">
				<DataGrid ItemsSource="{Binding Orders}" BorderThickness="0">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Order ID" Binding="{Binding InvoiceNo}" Width="150"/>
						<DataGridTextColumn Header="Buyer" Binding="{Binding Buyer.CompanyName}" Width="*"/>
						<DataGridTextColumn Header="Country" Binding="{Binding Buyer.Country}" Width="120"/>
						<DataGridTextColumn Header="Weight" Binding="{Binding TotalWeightKg, StringFormat={}{0:N0} kg}" Width="100"/>
						<DataGridTextColumn Header="Order Date" Binding="{Binding OrderedDate, StringFormat=yyyy-MM-dd}" Width="120"/>
						<DataGridTextColumn Header="Total (LKR)" Binding="{Binding TotalAmount, StringFormat=N0}" Width="130"/>
						<DataGridTemplateColumn Header="Status" Width="120">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border Style="{StaticResource StatusPill}"
                                            Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
										<TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="Action" Width="80">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Button Style="{StaticResource RowAction}" Content="⋯"
                                            Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>
		</DockPanel>

		<!-- Detail overlay -->
		<Grid Background="#66000000" Visibility="{Binding IsDetail, Converter={StaticResource BoolToVis}}">
			<Border Style="{StaticResource Card}" Width="460" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<Grid Margin="0,0,0,8">
							<StackPanel>
								<TextBlock Text="{Binding Selected.InvoiceNo}" Style="{StaticResource H2}"/>
								<TextBlock Text="{Binding Selected.Buyer.CompanyName}" Style="{StaticResource Caption}"/>
							</StackPanel>
							<Button Content="✕" Style="{StaticResource RowAction}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding CloseDetailCommand}"/>
						</Grid>

						<Border Style="{StaticResource StatusPill}" Margin="0,0,0,10"
                                Background="{Binding Selected.Status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
							<TextBlock Text="{Binding Selected.Status}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{Binding Selected.Status, Converter={StaticResource StatusBrush}}"/>
						</Border>

						<TextBlock Text="ORDER LINES" Style="{StaticResource FieldLabel}"/>
						<ItemsControl ItemsSource="{Binding Lines}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="#F6FAF3" CornerRadius="8" Padding="10,7" Margin="0,3">
										<Grid>
											<StackPanel>
												<TextBlock Text="{Binding SpiceName}" FontWeight="SemiBold" FontSize="13"/>
												<TextBlock Style="{StaticResource Caption}">
													<Run Text="{Binding QuantityKg, StringFormat={}{0:N0} kg, Mode=OneWay}"/>
													<Run Text=" × LKR "/>
													<Run Text="{Binding UnitPricePerKg, StringFormat={}{0:N0}, Mode=OneWay}"/>
												</TextBlock>
											</StackPanel>
											<TextBlock Text="{Binding LineTotal, StringFormat={}LKR {0:N0}}" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" FontWeight="Bold" FontSize="13"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<Border Background="{StaticResource PrimaryPaleBrush}" CornerRadius="10" Padding="12" Margin="0,10">
							<Grid>
								<TextBlock Text="Invoice Total" VerticalAlignment="Center" FontWeight="SemiBold"/>
								<TextBlock Text="{Binding Selected.TotalAmount, StringFormat={}LKR {0:N0}}" HorizontalAlignment="Right"
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
							</Grid>
						</Border>

						<Button Content="Advance Order Status ▶" Style="{StaticResource AccentButton}" Command="{Binding AdvanceStatusCommand}"/>
					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>

		<!-- ===== Create order overlay ===== -->
		<Grid Background="#66000000" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}">
			<Border Style="{StaticResource Card}" Width="520" MaxHeight="660" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock Text="New Export Order" Style="{StaticResource H2}" Margin="0,0,0,4"/>
						<TextBlock Text="BUYER" Style="{StaticResource FieldLabel}"/>
						<ComboBox ItemsSource="{Binding Buyers}" DisplayMemberPath="CompanyName" SelectedItem="{Binding NewBuyer}"/>

						<Border Background="#F6FAF3" CornerRadius="10" Padding="12" Margin="0,12,0,0">
							<StackPanel>
								<TextBlock Text="ADD LINE ITEM" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="80"/>
										<ColumnDefinition Width="90"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<ComboBox Grid.Column="0" ItemsSource="{Binding SellableProducts}" SelectedItem="{Binding LineSpice}" Margin="0,0,6,0"/>
									<TextBox Grid.Column="1" Text="{Binding LineQty, UpdateSourceTrigger=PropertyChanged}" ToolTip="Quantity (kg)" Margin="0,0,6,0"/>
									<TextBox Grid.Column="2" Text="{Binding LinePrice, UpdateSourceTrigger=PropertyChanged}" ToolTip="Price / kg" Margin="0,0,6,0"/>
									<Button Grid.Column="3" Content="Add" Style="{StaticResource AccentButton}" Padding="14,8" Command="{Binding AddLineCommand}"/>
								</Grid>
							</StackPanel>
						</Border>

						<TextBlock Text="ORDER LINES" Style="{StaticResource FieldLabel}" Margin="2,12,0,4"/>
						<ItemsControl ItemsSource="{Binding NewLines}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="10,7" Margin="0,3">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>
											<StackPanel>
												<TextBlock Text="{Binding SpiceName}" FontWeight="SemiBold" FontSize="13"/>
												<TextBlock Style="{StaticResource Caption}">
													<Run Text="{Binding QuantityKg, StringFormat={}{0:N0} kg, Mode=OneWay}"/>
													<Run Text=" × LKR "/>
													<Run Text="{Binding UnitPricePerKg, StringFormat={}{0:N0}, Mode=OneWay}"/>
												</TextBlock>
											</StackPanel>
											<TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat={}LKR {0:N0}}" VerticalAlignment="Center"
                                                       FontWeight="Bold" FontSize="13" Margin="0,0,8,0"/>
											<Button Grid.Column="2" Content="✕" Style="{StaticResource RowAction}" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<Grid Margin="0,18,0,0">
							<Button Content="Cancel" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding CancelCreateCommand}"/>
							<Button Content="Create Order" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding SaveOrderCommand}"/>
						</Grid>
					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>

		<!-- ===== New buyer overlay ===== -->
		<Grid Background="#66000000" Visibility="{Binding IsAddingBuyer, Converter={StaticResource BoolToVis}}">
			<Border Style="{StaticResource Card}" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
				<StackPanel>
					<TextBlock Text="New Buyer" Style="{StaticResource H2}" Margin="0,0,0,4"/>
					<TextBlock Text="COMPANY NAME" Style="{StaticResource FieldLabel}"/>
					<TextBox Text="{Binding BuyerCompany, UpdateSourceTrigger=PropertyChanged}"/>
					<TextBlock Text="COUNTRY" Style="{StaticResource FieldLabel}"/>
					<TextBox Text="{Binding BuyerCountry, UpdateSourceTrigger=PropertyChanged}"/>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" Margin="0,0,6,0">
							<TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
							<TextBox Text="{Binding BuyerEmail, UpdateSourceTrigger=PropertyChanged}"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Margin="6,0,0,0">
							<TextBlock Text="PHONE" Style="{StaticResource FieldLabel}"/>
							<TextBox Text="{Binding BuyerPhone, UpdateSourceTrigger=PropertyChanged}"/>
						</StackPanel>
					</Grid>
					<CheckBox Content="Export buyer (overseas)" Margin="2,12,0,0" IsChecked="{Binding BuyerIsExport}"/>
					<Grid Margin="0,18,0,0">
						<Button Content="Cancel" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding CancelAddBuyerCommand}"/>
						<Button Content="Save Buyer" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding SaveBuyerCommand}"/>
					</Grid>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</UserControl>
