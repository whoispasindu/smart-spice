<Window x:Class="SmartSpice.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartSpice — Sign In" Height="560" Width="880" Icon="/Assets/Images/logo.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border Grid.Column="0" Background="{StaticResource SpiceGradientBrush}">
            <StackPanel VerticalAlignment="Center" Margin="48">
                <Image Source="/Assets/Images/logo.png" Width="96" Height="96" HorizontalAlignment="Left"/>
                <TextBlock Text="SmartSpice" FontSize="40" FontWeight="Bold" Foreground="White" Margin="0,22,0,0"/>
                <TextBlock Text="Spice Factory Management System" FontSize="16"
                           Foreground="#CDEBD0" Margin="2,2,0,0"/>
                <Border Height="3" Width="64" Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Left" CornerRadius="2" Margin="2,18,0,18"/>
                <TextBlock Foreground="#E3F2E5" FontSize="13" TextWrapping="Wrap" MaxWidth="360"
                           HorizontalAlignment="Left"
                           Text="From farm collection to export dispatch — track inventory, grinding yield loss, quality and sales with full traceability."/>
                <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                    <TextBlock Text="●" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Real-time stock &amp; low-stock alerts" Foreground="#E3F2E5" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="●" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="AI-based yield prediction" Foreground="#E3F2E5" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="●" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Role-based access &amp; audit trail" Foreground="#E3F2E5" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Login form -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="44,0">
            <TextBlock Text="Welcome back" Style="{StaticResource H1}"/>
            <TextBlock Text="Sign in to continue" Style="{StaticResource Caption}" Margin="0,2,0,18"/>

            <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UsernameBox" Text="admin"/>

            <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PasswordBox" Password="admin123"
                         KeyDown="PasswordBox_KeyDown"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                       FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <Button Content="Sign In" Style="{StaticResource PrimaryButton}"
                    Margin="0,18,0,0" Height="44" Click="SignIn_Click"/>

            <Border Style="{StaticResource Pill}" Background="{StaticResource AccentPaleBrush}" Margin="0,22,0,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Demo accounts" FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                               Text="admin / admin123   (full access)"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="sales / sales123   •   quality / quality123"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
