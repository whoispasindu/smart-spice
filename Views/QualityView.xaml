<UserControl x:Class="SmartSpice.Views.QualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel Margin="20,4,20,16">
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="8,4,8,8">
                <StackPanel>
                    <TextBlock Text="Quality Control" Style="{StaticResource H1}"/>
                    <TextBlock Text="Inspect and manage quality of harvested spices." Style="{StaticResource Caption}" FontSize="13"/>
                </StackPanel>
                <Button Content="+ New Inspection" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Command="{Binding StartCreateCommand}"/>
            </Grid>

            <!-- Stat cards -->
            <UniformGrid DockPanel.Dock="Top" Columns="4">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#E3F1DF">
                            <TextBlock Text="🔬" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Total Inspections" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding TotalInspections}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#E3F1DF">
                            <TextBlock Text="✅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Passed" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding PassedCount}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#F8E2DF">
                            <TextBlock Text="❌" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Rejected" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding RejectedCount}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#DDEAF6">
                            <TextBlock Text="🌍" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Export Approved" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding ExportCount}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Table -->
            <Border Style="{StaticResource Card}" Padding="6">
                <DataGrid ItemsSource="{Binding Inspections}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Certificate" Binding="{Binding CertificateNo}" Width="150"/>
                        <DataGridTextColumn Header="Batch" Binding="{Binding Batch.BatchCode}" Width="*"/>
                        <DataGridTextColumn Header="Inspected" Binding="{Binding InspectedAt, StringFormat=yyyy-MM-dd}" Width="120"/>
                        <DataGridTemplateColumn Header="Grade" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{Binding Grade, Converter={StaticResource GradeToBrush}}">
                                        <TextBlock Text="{Binding Grade}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Moisture %" Binding="{Binding MoisturePercent, StringFormat=N1}" Width="100"/>
                        <DataGridTextColumn Header="Purity %" Binding="{Binding PurityPercent, StringFormat=N1}" Width="90"/>
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPill}"
                                            Background="{Binding ResultText, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
                                        <TextBlock Text="{Binding ResultText}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{Binding ResultText, Converter={StaticResource StatusBrush}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Action" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowAction}" Content="⋯"
                                            ToolTip="View certificate details"
                                            Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- Create overlay -->
        <Grid Background="#66000000" Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="New Inspection" Style="{StaticResource H2}"/>
                    <TextBlock Text="BATCH (only un-inspected or previously-failed)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Batches}" DisplayMemberPath="BatchCode" SelectedItem="{Binding FormBatch}"/>

                    <!-- Previous (failed) inspection shown when re-inspecting -->
                    <Border Background="#FFF3E0" CornerRadius="10" Padding="12" Margin="0,10,0,0"
                            Visibility="{Binding HasPrevious, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="⚠ Re-inspection — previous result" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                                <Run Text="Certificate "/><Run Text="{Binding PreviousInspection.CertificateNo, Mode=OneWay}"/>
                                <Run Text=" • "/><Run Text="{Binding PreviousInspection.InspectedAt, StringFormat=yyyy-MM-dd, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="Grade "/><Run Text="{Binding PreviousInspection.Grade, Mode=OneWay}"/>
                                <Run Text=" • Moisture "/><Run Text="{Binding PreviousInspection.MoisturePercent, StringFormat={}{0:N1}%, Mode=OneWay}"/>
                                <Run Text=" • Purity "/><Run Text="{Binding PreviousInspection.PurityPercent, StringFormat={}{0:N1}%, Mode=OneWay}"/>
                                <Run Text=" • "/><Run Text="{Binding PreviousInspection.ResultText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding PreviousInspection.Remarks, Mode=OneWay}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="GRADE" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Grades}" SelectedItem="{Binding FormGrade}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="MOISTURE (%)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding FormMoisture, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="PURITY (%)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FormPurity, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Passed food safety" Margin="2,12,0,0" IsChecked="{Binding FormPassed}"/>
                    <CheckBox Content="Approved for export" Margin="2,8,0,0" IsChecked="{Binding FormExport}"/>
                    <TextBlock Text="REMARKS" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FormRemarks, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="56"/>
                    <Grid Margin="0,18,0,0">
                        <Button Content="Cancel" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding CancelCreateCommand}"/>
                        <Button Content="Save Inspection" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding SaveInspectionCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Certificate detail popup ===== -->
        <Grid Background="#66000000" Visibility="{Binding IsDetail, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Quality Certificate" Style="{StaticResource H2}"/>
                            <TextBlock Text="{Binding DetailInspection.CertificateNo}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource RowAction}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CloseDetailCommand}"/>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Batch" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding DetailInspection.Batch.BatchCode}" FontWeight="SemiBold" FontSize="15"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="8" Padding="11,4" VerticalAlignment="Center"
                        Background="{Binding DetailInspection.Grade, Converter={StaticResource GradeToBrush}}">
                            <TextBlock Text="{Binding DetailInspection.Grade, StringFormat=Grade {0}}" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <Border Background="{StaticResource PrimaryPaleBrush}" CornerRadius="10" Padding="12" Margin="0,0,4,4">
                            <StackPanel>
                                <TextBlock Text="Moisture" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding DetailInspection.MoisturePercent, StringFormat={}{0:N1}%}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PrimaryPaleBrush}" CornerRadius="10" Padding="12" Margin="4,0,0,4">
                            <StackPanel>
                                <TextBlock Text="Purity" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding DetailInspection.PurityPercent, StringFormat={}{0:N1}%}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Food safety" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Right"
                        Background="{Binding DetailInspection.ResultText, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
                            <TextBlock Text="{Binding DetailInspection.ResultText}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{Binding DetailInspection.ResultText, Converter={StaticResource StatusBrush}}"/>
                        </Border>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Export approved" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                           Foreground="{Binding DetailInspection.ExportApproved, Converter={StaticResource BoolToStatusBrush}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="No"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DetailInspection.ExportApproved}" Value="True">
                                            <Setter Property="Text" Value="Yes 🌍"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Inspected" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DetailInspection.InspectedAt, StringFormat=yyyy-MM-dd HH:mm}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Inspector" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DetailInspection.Inspector.FullName, TargetNullValue=—}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>

                    <TextBlock Text="REMARKS" Style="{StaticResource FieldLabel}"/>
                    <Border Background="#F6FAF3" CornerRadius="8" Padding="10">
                        <TextBlock Text="{Binding DetailInspection.Remarks, TargetNullValue=—}" TextWrapping="Wrap" FontSize="13"/>
                    </Border>

                    <Button Content="Close" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                            HorizontalAlignment="Right" Command="{Binding CloseDetailCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
