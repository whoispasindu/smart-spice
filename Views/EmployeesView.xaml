<UserControl x:Class="SmartSpice.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel Margin="20,4,20,16">
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="8,4,8,8">
                <StackPanel>
                    <TextBlock Text="Employees" Style="{StaticResource H1}"/>
                    <TextBlock Text="Manage staff records. Click a name to view full details." Style="{StaticResource Caption}" FontSize="13"/>
                </StackPanel>
                <Button Content="+ Add Employee" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Command="{Binding NewCommand}"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- Stat cards -->
            <UniformGrid DockPanel.Dock="Top" Columns="4">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#E3F1DF">
                            <TextBlock Text="👥" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Total Employees" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding TotalEmployees}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#E3F1DF">
                            <TextBlock Text="✅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Active" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding ActiveEmployees}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#FBEFD2">
                            <TextBlock Text="🏷" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Departments" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding DepartmentCount}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#F8E2DF">
                            <TextBlock Text="💤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Inactive" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding OnLeaveEmployees}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Table -->
            <Border Style="{StaticResource Card}" Padding="6">
                <DataGrid ItemsSource="{Binding Employees}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}" Content="{Binding FullName}"
                                            Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Code" Binding="{Binding EmployeeCode}" Width="100"/>
                        <DataGridTextColumn Header="Position" Binding="{Binding Role}" Width="150"/>
                        <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="150"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPill}">
                                        <Border.Background>
                                            <Binding Path="IsActive" Converter="{StaticResource BoolToStatusBrush}"/>
                                        </Border.Background>
                                        <TextBlock Foreground="White" FontSize="11.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Inactive"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Active"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Action" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowAction}" Content="⋯" ToolTip="Edit employee"
                                            Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ===== Employee detail popup ===== -->
        <Grid Background="#66000000" Visibility="{Binding IsDetail, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource SpiceGradientBrush}">
                                <TextBlock Text="{Binding Detail.FullName}" Foreground="White" FontWeight="Bold" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Detail.FullName}" Style="{StaticResource H2}"/>
                                <Border Style="{StaticResource Pill}" Background="{StaticResource AccentPaleBrush}" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Detail.Role}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource RowAction}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CloseDetailCommand}"/>
                    </Grid>

                    <Grid Margin="0,2,0,0">
                        <TextBlock Text="Position" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Detail.Role}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Department" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Detail.Department}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Employee Code" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Detail.EmployeeCode}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Phone" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Detail.Phone, TargetNullValue=—}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Email" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Detail.Email, TargetNullValue=—}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Hire Date" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Detail.HireDate, StringFormat=yyyy-MM-dd}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Username" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Detail.Username}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Status" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                   Foreground="{Binding Detail.IsActive, Converter={StaticResource BoolToStatusBrush}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Inactive"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Detail.IsActive}" Value="True">
                                            <Setter Property="Text" Value="Active"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Content="Close" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                            HorizontalAlignment="Right" Command="{Binding CloseDetailCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Add / edit overlay ===== -->
        <Grid Background="#66000000" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="460" MaxHeight="660" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Employee Details" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                        <TextBlock Text="FULL NAME" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Selected.FullName, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="POSITION (ROLE)" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Selected.Role}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="DEPARTMENT" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Selected.Department, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="EMPLOYEE CODE" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Selected.EmployeeCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="PHONE" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Selected.Phone, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Selected.Email, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="ADDRESS" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Selected.Address, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="USERNAME (login)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Selected.Username, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="PASSWORD (blank = keep)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Active employee" Margin="2,12,0,0" IsChecked="{Binding Selected.IsActive}"/>
                        <Grid Margin="0,18,0,0">
                            <Button Content="Cancel" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding CancelCommand}"/>
                            <Button Content="Save Employee" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding SaveCommand}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>