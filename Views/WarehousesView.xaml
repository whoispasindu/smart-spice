<UserControl x:Class="SmartSpice.Views.WarehousesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel Margin="20,4,20,16">
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="8,4,8,8">
                <StackPanel>
                    <TextBlock Text="Warehouses" Style="{StaticResource H1}"/>
                    <TextBlock Text="Monitor storage locations and bin capacity." Style="{StaticResource Caption}" FontSize="13"/>
                </StackPanel>
                <Button Content="+ Add Warehouse" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Command="{Binding NewCommand}"/>
            </Grid>

            <!-- Stat cards -->
            <UniformGrid DockPanel.Dock="Top" Columns="4">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#E3F1DF">
                            <TextBlock Text="🏬" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Warehouses" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding Count}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#DDEAF6">
                            <TextBlock Text="📦" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Total Capacity" Style="{StaticResource Caption}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalCapacity}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="KG" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,3" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#FBEFD2">
                            <TextBlock Text="📥" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Total Stored" Style="{StaticResource Caption}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalUsed}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="KG" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,3" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#E3F1DF">
                            <TextBlock Text="📊" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Avg Utilisation" Style="{StaticResource Caption}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AvgUtilization}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="%" FontSize="12" VerticalAlignment="Bottom" Margin="2,0,0,3" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Warehouse cards -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Warehouses}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="392" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource PrimaryPaleBrush}">
                                                <TextBlock Text="🏬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/>
                                                <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Style="{StaticResource RowAction}" Content="⋯" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>

                                    <!-- Big utilisation figure -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding UtilizationPercent, StringFormat={}{0:N0}%}" FontSize="30" FontWeight="Bold"
                                                   Foreground="{Binding FillPercent, Converter={StaticResource PercentToLevelBrush}}"/>
                                        <TextBlock Text="capacity used" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="8,0,0,7"/>
                                    </StackPanel>

                                    <!-- Proportional fill bar (star grid → always correct width) -->
                                    <Border CornerRadius="8" Height="18" Background="#EAEFE6" ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding FillPercent, Converter={StaticResource PercentToStar}}"/>
                                                <ColumnDefinition Width="{Binding EmptyPercent, Converter={StaticResource PercentToStar}}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="8"
                                                    Background="{Binding FillPercent, Converter={StaticResource PercentToLevelBrush}}"/>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Used" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="{Binding UsedKg, StringFormat={}{0:N0} kg}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Free" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="{Binding FreeKg, StringFormat={}{0:N0} kg}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="Total" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="{Binding CapacityKg, StringFormat={}{0:N0} kg}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat={}{0} stock lines stored}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Add / edit overlay -->
        <Grid Background="#66000000" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Warehouse" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Text="NAME" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="LOCATION" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Selected.Location, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="CAPACITY (KG)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Selected.CapacityKg, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Delete" Style="{StaticResource GhostButton}"
                                Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}"
                                Command="{Binding DeleteCommand}"/>
                        <Button Grid.Column="1" Content="Cancel" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
                        <Button Grid.Column="2" Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>