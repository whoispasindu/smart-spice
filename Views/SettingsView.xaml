<UserControl x:Class="SmartSpice.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel Margin="20,4,20,16">
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Margin="8,4,8,10">
                <TextBlock Text="Settings" Style="{StaticResource H1}"/>
                <TextBlock Text="Manage your account and application settings." Style="{StaticResource Caption}" FontSize="13"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sub-nav -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                    <StackPanel>
                        <RadioButton Style="{StaticResource FilterTab}" GroupName="settings" IsChecked="True"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                     Content="👤  Profile" Command="{Binding SelectSectionCommand}" CommandParameter="profile"/>
                        <RadioButton Style="{StaticResource FilterTab}" GroupName="settings"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                     Content="🔒  Change Password" Command="{Binding SelectSectionCommand}" CommandParameter="password"/>
                    </StackPanel>
                </Border>

                <!-- Section content -->
                <Grid Grid.Column="1">
                    <!-- ===== Profile ===== -->
                    <Grid Visibility="{Binding ActiveSection, Converter={StaticResource KeyToVis}, ConverterParameter=profile}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Profile Information" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                <TextBlock Text="FULL NAME" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ProfileEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="PHONE" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ProfilePhone, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="ROLE" Style="{StaticResource FieldLabel}"/>
                                        <Border Background="#F3F6F0" CornerRadius="8" Padding="10,9">
                                            <TextBlock Text="{Binding RoleText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                                        <Border Background="#F3F6F0" CornerRadius="8" Padding="10,9">
                                            <TextBlock Text="{Binding UsernameText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Update Profile" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                                        HorizontalAlignment="Left" Command="{Binding UpdateProfileCommand}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Profile Picture" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <Border Width="96" Height="96" CornerRadius="48" Background="{StaticResource SpiceGradientBrush}" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="34" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding RoleText}" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Account Information" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                                    <TextBlock Text="EMPLOYEE CODE" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding EmployeeCode}" FontWeight="SemiBold"/>
                                    <TextBlock Text="DEPARTMENT" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Department}" FontWeight="SemiBold"/>
                                    <TextBlock Text="LAST LOGIN" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding LastLoginText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="ACCOUNT STATUS" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="9" Height="9" CornerRadius="5" Background="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="6,0,0,0" Foreground="{StaticResource SuccessBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Change password ===== -->
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top" Width="460" HorizontalAlignment="Left"
                            Visibility="{Binding ActiveSection, Converter={StaticResource KeyToVis}, ConverterParameter=password}">
                        <StackPanel>
                            <TextBlock Text="Change Password" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                            <TextBlock Text="Use at least 6 characters." Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <TextBlock Text="CURRENT PASSWORD" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="CurrentPwd"/>
                            <TextBlock Text="NEW PASSWORD" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="NewPwd"/>
                            <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="ConfirmPwd"/>
                            <Button Content="Update Password" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                                    HorizontalAlignment="Left" Click="ChangePassword_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
